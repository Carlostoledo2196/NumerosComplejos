# Configuración de Firebase (consola de Firebase → Configuración del proyecto → Tus apps → App web).
# Estos valores NO son secretos: Firebase los diseña para ir en el navegador. La seguridad la dan
# las reglas de Firestore (firestore.rules) y la lista de docentes autorizados.
# En Netlify: Site configuration → Environment variables (mismos nombres).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: grupos sugeridos en el registro, separados por coma (si se deja vacío, el grupo es texto libre).
VITE_OVA_GRUPOS=

# Solo para desarrollo local con los emuladores de Firebase (npm run emuladores).
VITE_USE_EMULATORS=false
