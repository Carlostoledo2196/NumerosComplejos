{
  "name": "ova-complejos-cuanticos",
  "version": "0.1.0",
  "private": true,
  "description": "OVA: Evocación de números complejos y sus operaciones aplicadas a la computación cuántica",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-ova \"vitest run --config vitest.rules.config.ts\"",
    "emuladores": "npx -y firebase-tools@14 emulators:start --only auth,firestore --project demo-ova"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^12.19.0",
    "katex": "^0.16.47"
  }
}
